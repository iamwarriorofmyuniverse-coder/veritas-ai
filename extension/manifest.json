{
  "manifest_version": 3,
  "name": "VeritasAI - Live Fact-Checking Engine",
  "version": "1.0.0",
  "description": "1-click automated fact-checking on social feeds grounded against live Google News Wire RSS feeds.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VeritasAI Fact-Checker"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
